


RewriteEngine on
RewriteCond %{HTTP_HOST} ^eastasia.in [NC,OR]
RewriteCond %{HTTP_HOST} ^www.eastasia.in [NC]
RewriteRule ^(.*)$ http://eastasiatrading.com/ [L,R=301,NC]

